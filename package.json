{
  "name": "domino-ai",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "seed": "pnpm --filter @domino/sim seed",
    "sim:print": "pnpm --filter @domino/sim print",
    "convex:fixtures": "pnpm --filter @domino/web exec convex run dev/seedFixtures:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "2.1.3",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
