# Domino: every key the project needs.
# Copy this file to .env.local (and apps/web/.env.local) and fill in the values.
# Never commit real keys. Shared keys live in the team password manager.
# Server-only keys also go in Convex: npx convex env set NAME value

# ---------- Convex (database + backend) ----------
# Written for you by `npx convex dev`. Each developer has their own dev deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ---------- Claude (live agents: proposeFixes, explain) ----------
ANTHROPIC_API_KEY=
# Model id to use. Check the Anthropic console for the current id.
ANTHROPIC_MODEL=

# ---------- CREAO (learning agents: mapSource, readConstraints, weekly brief) ----------
CREAO_API_KEY=
# Base URL of the CREAO agent API. Confirm in the CREAO starter pack / docs.
CREAO_API_BASE_URL=
# Agent ids from agent.creao.ai (one agent per job). Put these in the README for judging too.
CREAO_AGENT_ID_MAPSOURCE=
CREAO_AGENT_ID_CONSTRAINTS=
CREAO_AGENT_ID_BRIEF=

# Which backend runs each agent job: creao | claude
AGENT_BACKEND_MAPSOURCE=creao
AGENT_BACKEND_CONSTRAINTS=creao
AGENT_BACKEND_BRIEF=creao
AGENT_BACKEND_PROPOSEFIXES=claude
AGENT_BACKEND_EXPLAIN=claude

# ---------- Capital One Nessie (bank data) ----------
NESSIE_API_KEY=
# Confirm the base URL in the Nessie docs.
NESSIE_BASE_URL=http://api.nessieisreal.com

# ---------- Mock servers (Stripe, CRM, cards, books, payroll, docs) ----------
# We mock every tool except the bank. No real Stripe/Ramp/HubSpot/Gusto keys needed.
# Local: http://localhost:4010. Deployed: the public URL of apps/mocks (CREAO agents must reach it).
MOCKS_BASE_URL=http://localhost:4010
# Shared secret the mock server checks on every request
MOCKS_API_KEY=dev-mocks-key

# ---------- Simulator ----------
SIM_COMPANY=kestrel
SIM_SEED=42

# ---------- SEC EDGAR (public company data for calibration) ----------
# EDGAR requires a User-Agent with a name and contact email.
SEC_EDGAR_USER_AGENT="Domino CalHacks your-email@example.com"

# ---------- Optional add-ons ----------
# Apify: customer news risk signals (only after the Saturday evening gate)
APIFY_TOKEN=
